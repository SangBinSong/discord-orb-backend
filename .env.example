# Docker Compose variable substitution (.env).
# Put Discord secrets and operator IDs in a separate .env.backend file (template: .env.backend.example).

ORB_DOMAIN=orb.example.com
ORB_BACKEND_IMAGE=discord-orb-backend:local

# Optional for deployments using compose.cert.yaml.
# ORB_TLS_CERT_FILE=/path/to/fullchain.pem
# ORB_TLS_KEY_FILE=/path/to/privkey.pem

# Optional for deployments using compose.external-proxy.yaml.
# ORB_BIND_HOST=127.0.0.1
# ORB_BIND_PORT=8080
