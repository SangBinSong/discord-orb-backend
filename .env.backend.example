# Backend runtime secrets and operator settings.
# Copy this file to .env.backend and keep real values only on the host (never commit .env.backend).

ORB_DISCORD_CLIENT_ID=replace-with-client-id
ORB_DISCORD_CLIENT_SECRET=replace-with-client-secret

# Raw Discord bot token without the "Bot " prefix (the backend prepends "Bot " automatically).
ORB_DISCORD_BOT_TOKEN=replace-with-bot-token

# Long random signing secret (for example: openssl rand -hex 32).
ORB_SESSION_SECRET=replace-with-long-random-secret

# Comma-separated Discord user IDs allowed to access /dashboard (leave empty to deny everyone).
ORB_OPERATOR_DISCORD_IDS=123456789012345678
